# Copy to .env. Every setting is optional.

# Port on this machine.
DASHBOARD_PORT=8000

# Admin password for adding and removing sources in the browser. Create the value with:
#   docker compose run --rm dashboard rssac002-dashboard hash-password
# Leave empty to manage sources from the command line only.
RSSAC002_ADMIN_PASSWORD_HASH=

# Signs admin sessions. Set any long random text to stay signed in across restarts.
RSSAC002_SESSION_SECRET=

# Hours between automatic checks for new reports. 0 turns them off.
RSSAC002_SCAN_INTERVAL_HOURS=6

# Set to true when the dashboard is served over HTTPS.
RSSAC002_COOKIE_SECURE=false

# Requests one visitor may make per minute to the API and file tree (a zip download counts as 40).
# 0 turns the limit off.
RSSAC002_RATE_LIMIT=240

# Set to true when a reverse proxy in front passes the visitor's address in X-Forwarded-For.
# Leave false when the dashboard is reached directly.
RSSAC002_TRUST_PROXY=false

# Most report files one zip download may hold.
RSSAC002_MAX_ARCHIVE_REPORTS=6000
